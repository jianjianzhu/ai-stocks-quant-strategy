strongAlignmentV5 = input.bool(false, '强买同时要求快线多头', group = V5_GROUP, tooltip = '要求快 EMA > 中 EMA 且收盘价 > 快 EMA。')
showEntryLineV5 = input.bool(false, '显示固定入场参考价', group = V5_GROUP)
