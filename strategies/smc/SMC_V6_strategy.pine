// V5 reliability / optional risk controls. Signal entries and exits ALWAYS confirm at close.
V5_GROUP = 'V5 确认与风控'
reentryBarsV5 = input.int(1, '退出后等待完整 K 线数', minval = 0, group = V5_GROUP)
