//@version=5
strategy('Smart Money Concepts V6 [Strategy]', 'SMC V6 策略回测', overlay = true,
     initial_capital = 100000, currency = currency.USD,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 100,
     commission_type = strategy.commission.percent, commission_value = 0.10,
     slippage = 1, pyramiding = 0, process_orders_on_close = true,
     calc_on_order_fills = false, calc_on_every_tick = false,
     max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)
//---------------------------------------------------------------------------------------------------------------------}
//CONSTANTS & STRINGS & INPUTS
//---------------------------------------------------------------------------------------------------------------------{
